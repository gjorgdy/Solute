{
  "schemaVersion": 1,
  "id": "vanillaplus",
  "version": "${version}",

  "name": "Hexasis VanillaPlus",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Gjorgdy"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },

  "license": "CC0-1.0",
  "icon": "assets/vanillaplus/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.gjorgdy.vanillaplus.VanillaPlus"
    ]
  },
  "mixins": [
    "vanillaplus.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.17",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/block/entity/SignBlockEntity.class": ["nl/gjorgdy/vanillaplus/interfaces/SignShopInterface.java"],
      "net/minecraft/block/entity/LootableContainerBlockEntity.class": ["nl/gjorgdy/vanillaplus/interfaces/HoloShopInterface.java"],
      "net/minecraft/entity/player/PlayerEntity.class": ["nl/gjorgdy/vanillaplus/interfaces/PlayerEntityInterface.java"],
      "net/minecraft/projectile/thrown/EnderPearlEntity.class": ["nl/gjorgdy/vanillaplus/interfaces/EnderPearlEntityInterface.java"]
    }
  }
}
