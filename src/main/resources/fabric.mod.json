  "authors": [
    "Gjorgdy"
  ],
  "contact": {
    "homepage": "https://hexasis.eu/",
    "sources": "https://github.com/gjorgdy/Solute/"
  },

  "license": "CC0-1.0",
  "icon": "assets/solute/icon.png",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "nl.gjorgdy.solute.Solute"
    ],
    "main": [
      "nl.gjorgdy.solute.Solute"
    ]
  },
  "mixins": [
    "solute.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.129.0+1.21.7",
    "minecraft": ">=1.21.7",
