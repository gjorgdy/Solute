{
  "schemaVersion": 1,
  "id": "solute",
  "version": "${version}",
  "name": "Solute by Gjorgdy",
  "description": "A solute is an element used together with a base to create an alloy using the best features of both.",
  "authors": [
    "Gjorgdy"
  ],
  "contact": {
    "homepage": "https://hexasis.eu/",
    "sources": "https://github.com/gjorgdy/Solute/"
  },

  "license": "CC0-1.0",
  "icon": "assets/solute/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.gjorgdy.solute.Solute"
    ]
  },
  "mixins": [
    "solute.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=21",
    "fabric": "*",
    "fzzy_config": ">=${fzzyConfigVersion}"
  },
  "custom": {
    "fzzy_config": [
      "solute"
    ]
  }
}
