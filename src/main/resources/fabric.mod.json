{
  "schemaVersion": 1,
  "id": "vanillaplus",
  "version": "${version}",

  "name": "Solute by Gjorgdy",
  "description": "A solute is an element used together with a base to create an alloy using the best features of both.",
  "authors": [
    "Gjorgdy"
  ],
  "contact": {
    "homepage": "https://hexasis.eu/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },

  "license": "CC0-1.0",
  "icon": "assets/solute/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.gjorgdy.solute.Solute"
    ]
  },
  "mixins": [
    "solute.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.6",
    "java": ">=21"
  },
  "suggests": {
    "another-mod": "*"
  }
}
